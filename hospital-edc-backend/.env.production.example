# EDC 生产/测试服环境配置模板
# 用法:
#   cp .env.production.example .env.production
#   vim .env.production   # 所有 <...> 占位必须替换
#
# ⚠️ .env.production 已被 .gitignore 排除,严禁提交入库。
# ⚠️ 一旦录入数据,FIELD_ENCRYPTION_KEY 不可再改(改了姓名/身份证无法解密)。

# ── 数据库(由 docker-compose.prod.yml 的 mysql 容器提供)──
# MySQL root 密码:强随机值。生成:python -c "import secrets;print(secrets.token_urlsafe(24))"
MYSQL_ROOT_PASSWORD=<强随机密码,与下面 DATABASE_URL 中一致>
MYSQL_DATABASE=edc_prod
# DATABASE_URL 由 compose 注入(指向容器内 mysql 服务),无需在此填写;
# 仅当脱离 compose 单独跑后端时才需要:
# DATABASE_URL=mysql+pymysql://root:<密码>@localhost:3306/edc_prod?charset=utf8mb4

# ── 认证 ───────────────────────────────────────────
# JWT 签名密钥:python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=<强随机值>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── 敏感字段加密(姓名/身份证 Fernet)──────────────
# 任意非空字符串(自动派生 Fernet key)。设库后不可更改!
FIELD_ENCRYPTION_KEY=<设定后不可更改的随机串>

# ── 实例标识 ───────────────────────────────────────
PROJECT_NAME=三一照护研究
PORT=8000

# ── 上传目录(知情同意扫描件)──────────────────────
UPLOAD_DIR=./uploads
