# EDC 后端环境配置模板
# 复制为 .env 并填入实际值。多实例部署时每个项目/医院一份独立 .env
# （不同 PORT / DATABASE_URL / 密钥），一份镜像即可跑多实例。

# ── 数据库 ─────────────────────────────────────────
# MySQL：mysql+pymysql://用户:密码@主机:3306/库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:edc123456@localhost:3306/hospital_edc?charset=utf8mb4

# ── 认证 ───────────────────────────────────────────
# JWT 签名密钥：生产必须用强随机值，如 python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── 敏感字段加密（姓名/身份证 Fernet）──────────────
# 任意非空字符串即可（自动派生 Fernet key），但一旦设定不可更改，否则已存数据无法解密
FIELD_ENCRYPTION_KEY=change-me-fernet-passphrase

# ── 实例标识（多实例部署用）────────────────────────
# 页面标题/项目名，每个项目实例自定义
PROJECT_NAME=三一照护研究
# Docker/uvicorn 监听端口
PORT=8000

# ── 上传目录（知情同意扫描件）──────────────────────
UPLOAD_DIR=./uploads
